+static char linux_bios7[1024], linux_bios9[1024], linux_firmware[1024], linux_save[1024];
+static _Atomic int linux_active, linux_save_error;
+static uint16_t linux_nickname[10]; static size_t linux_nickname_units;
+static uint32_t linux_profile_color, linux_profile_month, linux_profile_day;
+int nds_linux_config_set_paths(const nds_linux_config_paths_t *p) {
+    if (!p || p->struct_size < sizeof(*p) || !p->bios_arm7 || !p->bios_arm9 || !p->firmware_path || !p->save_path || p->nickname_units > 10 || (p->nickname_units && !p->nickname)) return 0;
+    const char *src[4]={p->bios_arm7,p->bios_arm9,p->firmware_path,p->save_path}; char *dst[4]={linux_bios7,linux_bios9,linux_firmware,linux_save};
+    for (unsigned i=0;i<4;i++) { size_t n=strlen(src[i]); if(n>=1024) return 0; memcpy(dst[i],src[i],n+1); }
+    linux_nickname_units=p->nickname_units; if(p->nickname_units) memcpy(linux_nickname,p->nickname,p->nickname_units*sizeof(uint16_t));
+    linux_profile_color=p->color; linux_profile_month=p->birthday_month; linux_profile_day=p->birthday_day;
+    atomic_store(&linux_save_error,0); atomic_store(&linux_active,1); return 1;
+}
+void nds_linux_config_reset(void){atomic_store(&linux_active,0);atomic_store(&linux_save_error,0);memset(linux_bios7,0,sizeof linux_bios7);memset(linux_bios9,0,sizeof linux_bios9);memset(linux_firmware,0,sizeof linux_firmware);memset(linux_save,0,sizeof linux_save);}
+int nds_linux_config_active(void){return atomic_load(&linux_active);}
+const char *nds_linux_config_bios_arm7(void){return nds_linux_config_active()?linux_bios7:0;}
+const char *nds_linux_config_bios_arm9(void){return nds_linux_config_active()?linux_bios9:0;}
+const char *nds_linux_config_firmware(void){return nds_linux_config_active()?linux_firmware:0;}
+const char *nds_linux_config_save_path(void){return nds_linux_config_active()?linux_save:0;}
+void nds_linux_config_apply_profile(nds_t *nds){if(nds_linux_config_active()&&linux_nickname_units)nds_set_firmware_user(nds,linux_nickname,linux_nickname_units,1u|(linux_profile_color<<8)|((linux_profile_month-1)<<16)|(linux_profile_day<<24));}
+void nds_linux_config_save_error(void){atomic_store(&linux_save_error,1);}
+int nds_linux_config_save_failed(void){return atomic_load(&linux_save_error);}
+
 void nds_set_firmware_user(nds_t *nds, const uint16_t *nickname, size_t units,
                            uint32_t packed)
 {
